{
  "name": "Trade",
  "type": "object",
  "properties": {
    "bot_run_id": {
      "type": "string",
      "description": "Associated bot run ID"
    },
    "market_name": {
      "type": "string",
      "description": "Market question"
    },
    "market_id": {
      "type": "string",
      "description": "Polymarket condition ID"
    },
    "gamma_market_id": {
      "type": "string",
      "description": "Gamma API market id"
    },
    "token_id": {
      "type": "string",
      "description": "CLOB token id of the outcome held"
    },
    "event_title": {
      "type": "string"
    },
    "event_slug": {
      "type": "string"
    },
    "market_slug": {
      "type": "string"
    },
    "market_url": {
      "type": "string",
      "description": "Link to the market on polymarket.com"
    },
    "side": {
      "type": "string",
      "enum": [
        "buy",
        "sell"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "YES",
        "NO"
      ],
      "description": "YES or NO token traded"
    },
    "entry_price": {
      "type": "number"
    },
    "exit_price": {
      "type": "number"
    },
    "current_price": {
      "type": "number",
      "description": "Latest mark (bid) while open"
    },
    "quantity": {
      "type": "number",
      "description": "Shares"
    },
    "size_usdc": {
      "type": "number",
      "description": "Cost at entry"
    },
    "pnl": {
      "type": "number",
      "description": "Realized P&L once closed"
    },
    "unrealized_pnl": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ],
      "default": "open"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "exit_time": {
      "type": "string",
      "format": "date-time"
    },
    "exit_reason": {
      "type": "string"
    },
    "order_type": {
      "type": "string",
      "enum": [
        "GTC",
        "GTD",
        "FOK",
        "FAK"
      ],
      "default": "GTC"
    },
    "edge_at_entry": {
      "type": "number",
      "description": "Estimated edge (%) at time of entry vs market price"
    },
    "est_prob": {
      "type": "number",
      "description": "Strategy's estimated win probability at entry"
    },
    "kelly_fraction": {
      "type": "number",
      "description": "Kelly fraction applied to this trade"
    },
    "neg_risk": {
      "type": "boolean",
      "default": false
    },
    "fill_mode": {
      "type": "string",
      "description": "paper | simulated | live, with a -maker suffix for passive fills"
    },
    "strategy": {
      "type": "string"
    },
    "signal": {
      "type": "string",
      "description": "Signal id that opened the position"
    },
    "signal_value": {
      "type": "number",
      "description": "Signal magnitude at entry (price move, imbalance, spread, edge)"
    },
    "signal_reason": {
      "type": "string",
      "description": "Human-readable reason for the entry"
    },
    "pilot_address": {
      "type": "string",
      "description": "Copy bots: the wallet this lot mirrors"
    },
    "outcome_label": {
      "type": "string",
      "description": "Outcome name as Polymarket shows it (team name, candidate, …)"
    },
    "basket_id": {
      "type": "string",
      "description": "Groups the legs of an arbitrage basket"
    },
    "basket_payout": {
      "type": "number",
      "description": "Guaranteed payout per set for a basket leg"
    }
  },
  "required": [
    "bot_run_id",
    "market_name",
    "side",
    "entry_price",
    "quantity"
  ]
}
